# ============================================================
# ALEXANDER CAST — Portal Personal Unificado
# Variables de entorno (copiar a .env.local y completar)
# NUNCA subir .env.local al repositorio.
# ============================================================

# ── SITIO ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://alexandercast.com
NEXT_PUBLIC_CAL_LINK=https://cal.com/alexandercast/consultoria

# ── SUPABASE (server — service role) ─────────────────────────
# Usado en Server Actions y Route Handlers. NO exponer al navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── SUPABASE (browser — anon key) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── RESEND (email transaccional + newsletter) ─────────────────
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM=
# IA Master Tech: recipient of the /diagnostico lead notification.
DIAGNOSTICO_NOTIFY_TO=

# ── UPSTASH REDIS (rate limiting) ────────────────────────────
# Dashboard: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── MÓDULO CLIENTES (Form_Clientes) ──────────────────────────
# Google OAuth para autenticación y guardado en Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://alexandercast.com/api/auth/callback
GOOGLE_DRIVE_FOLDER_ID=

# Groq para sugerencias IA en el formulario de onboarding
GROQ_API=

# ── ANTHROPIC (Claude API) ───────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OPENAI (fallback / GPT) ──────────────────────────────────
OPENAI_API_KEY=

# ── GOOGLE / GEMINI ──────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=jarvis-kreoon-ai

# ── ELEVENLABS (voz "Cristian Sanchez" — paisa colombiano) ───
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── TELEGRAM (bot de ideas) ──────────────────────────────────
# El bot manda notas de voz que entran a /admin/ideas ya transcritas.
# Token: se saca de @BotFather. Secreto: cualquier hex de 32 bytes; el
# webhook rechaza todo POST que no lo traiga en la cabecera.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Modelo de Gemini que escucha el audio. Aparte de GEMINI_MODEL porque no
# todos los modelos aceptan audio. Por defecto: gemini-2.5-flash.
GEMINI_MODEL_AUDIO=

# ── CONTENT FORGE (scripts/content-forge/) ───────────────────
# WaveSpeed AI — generación de imágenes premium
WAVESPEED_API_KEY=

# Apify — scraping de referentes y contenido viral
APIFY_API_TOKEN=
APIFY_ACTOR_INSTAGRAM=apify/instagram-scraper
APIFY_ACTOR_TIKTOK=clockworks/tiktok-scraper
APIFY_ACTOR_YOUTUBE=apify/youtube-scraper
APIFY_ACTOR_LINKEDIN=apify/linkedin-post-scraper

# ── META / FACEBOOK ──────────────────────────────────────────
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=

# ── N8N (automatizaciones) ───────────────────────────────────
N8N_BASE_URL=https://dev.kreoon.com
N8N_API_KEY=
N8N_WEBHOOK_BASE=https://dev.kreoon.com/webhook
N8N_WEBHOOK_APIFY_RESULTS=
N8N_WEBHOOK_CONTENT_ALERT=
N8N_WEBHOOK_NEW_POST_IDEA=

# ── REDES SOCIALES ───────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── KREOON (SaaS interno) ────────────────────────────────────
KREOON_API_URL=https://kreoon.com/api
KREOON_API_KEY=

# ── NOTICIAS / BÚSQUEDA ──────────────────────────────────────
NEWSCATCHER_API_KEY=
NEWSCATCHER_BASE_URL=https://catchall.newscatcherapi.com
TAVILY_API_KEY=

# ── REFERENTES POR PILAR ─────────────────────────────────────
INSTAGRAM_REFERENTS_P1=danielhabif,yokoikenjidiaz,pastorcashluna,marcosbrunet
INSTAGRAM_REFERENTS_P2=mastermunozoficial,comousarapps,artificialmente.ia
TIKTOK_REFERENTS_P3=camilapudim,viihtube,virginiafonseca,magalu
INSTAGRAM_REFERENTS_P4=ramiro.cubria,vilmanunez,mastermunozoficial
YOUTUBE_REFERENTS_P4=felipevergara,thedankoe

# ── SISTEMA ──────────────────────────────────────────────────
SYSTEM_NAME=alexander-cast-portal
SYSTEM_ENV=development
SYSTEM_LANGUAGE=es
LOG_LEVEL=INFO
LOG_FILE=logs/system.log

# ── IA MASTER TECH: PAGOS (STRIPE) Y REFERIDOS ───────────────
# Cuenta de Stripe de IMT. Si IMT_STRIPE_SECRET_KEY está vacía se usa STRIPE_SECRET_KEY.
IMT_STRIPE_SECRET_KEY=
# Secreto del endpoint https://<dominio>/api/imt/stripe (propio, NO el de /api/comunidad/stripe).
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, invoice.paid,
# invoice.payment_failed, customer.subscription.deleted, charge.refunded
IMT_STRIPE_WEBHOOK_SECRET=
